+++ b/bnet_to_sbml.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+"""Write an SBML-qual copy of .bnet networks for H.E., next to each .bnet file.
+
+H.E.'s encoder (bsaf.jar) numbers the CNF variables alphabetically when it reads
+SBML, but in an arbitrary (hash) order when it reads .bnet, and its model counter
+(bdd_minisat_all) depends strongly on that order: the same network can need 1 GB
+from SBML and run out of memory from .bnet. The original BBM runs read the
+biodivine SBML files, so the reduced BBM networks are given to H.E. as SBML too;
+run_benchmarks.py --reduced picks up the .sbml next to each .bnet. The network
+is unchanged: bsaf.jar produces the same clauses from both files.
+
+Usage, from the repository root after bn_reduce.py (needs `pip install biodivine_aeon`):
+
+    python3 bnet_to_sbml.py benchmarks/reduced/D2/BBM benchmarks/reduced/B/BBM
+
+Rerun it whenever bn_reduce.py has rewritten the .bnet files.
+"""
+import argparse
+import sys
+from pathlib import Path
+
+try:
+    import biodivine_aeon as ba
+except ImportError:
+    sys.exit("needs the AEON Python bindings: pip install biodivine_aeon")
+
+
+def convert(bnet):
+    bn = ba.BooleanNetwork.from_file(str(bnet)).infer_valid_graph()  # .bnet has no regulation signs
+    sbml = bnet.with_suffix('.sbml')
+    sbml.write_text(bn.to_sbml())
+    return sbml
+
+
+def main():
+    ap = argparse.ArgumentParser(description='Write an SBML copy of .bnet networks for H.E.')
+    ap.add_argument('paths', nargs='+', type=Path, help='.bnet files or folders of them')
+    a = ap.parse_args()
+    files = sorted(f for p in a.paths for f in (p.glob('*.bnet') if p.is_dir() else [p]))
+    if not files:
+        sys.exit('no .bnet files in ' + ', '.join(map(str, a.paths)))
+    failed = []
+    for f in files:
+        try:
+            convert(f)
+        except Exception as e:  # keep going; report at the end
+            failed.append(f)
+            print(f'FAILED {f}: {type(e).__name__}: {e}', file=sys.stderr)
+    print(f'{len(files) - len(failed)} of {len(files)} networks written as .sbml next to their .bnet')
+    if failed:
+        sys.exit(1)
+
+
+if __name__ == '__main__':
+    main()
